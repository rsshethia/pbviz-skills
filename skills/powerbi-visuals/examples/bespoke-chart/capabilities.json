{
  "privileges": [],
  "dataRoles": [
    {
      "displayName": "Category",
      "name": "category",
      "kind": "Grouping"
    },
    {
      "displayName": "Values",
      "name": "measure",
      "kind": "Measure"
    }
  ],
  "dataViewMappings": [
    {
      "conditions": [
        { "category": { "max": 1 }, "measure": { "min": 1, "max": 1 } }
      ],
      "categorical": {
        "categories": { "for": { "in": "category" } },
        "values": { "select": [{ "bind": { "to": "measure" } }] }
      }
    }
  ],
  "objects": {
    "dataColors": {
      "properties": {
        "fill": { "type": { "fill": { "solid": { "color": true } } } }
      }
    }
  },
  "supportsHighlight": true,
  "supportsKeyboardFocus": true
}
